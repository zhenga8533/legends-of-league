---
import BaseLayout from "../layouts/BaseLayout.astro";
---

<BaseLayout title="Legends of League">
  <section class="max-w-3xl space-y-4">
    <p class="text-sm font-medium uppercase tracking-widest text-accent">Under construction</p>
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Legends of League</h1>
    <p class="text-lg text-muted">
      An archive of every Worlds, Mid-Season Invitational and First Stand, from brackets and
      standings down to drafts and player stats, with a simulator for replaying history and
      forecasting what comes next.
    </p>
  </section>
</BaseLayout>
