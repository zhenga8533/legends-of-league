{
  "id": "worlds-2024",
  "name": "World Championship 2024",
  "editions": ["ed:worlds-2024"],
  "sources": [
    "https://cdn.sanity.io/files/dsfx7636/news/f69130a70849462c75fbd834f740f170963b173e.pdf",
    "https://lol.fandom.com/wiki/2024_Season_World_Championship"
  ],
  "notes": [
    "Play-In: 8-team Swiss, two wins to qualify, all Bo3. Swiss: 16 teams, three wins or losses, Bo3 when a match can decide advancement or elimination, otherwise Bo1. Knockout: 8-team single elimination, Bo5.",
    "Formats, series lengths and placements are verified by replaying the recorded results.",
    "Not modelled: the Swiss round-1 pools, region protection in draws, and the exact knockout draw. Forward simulations draw these randomly, except that undefeated Swiss teams are kept apart and face 3-2 teams."
  ],
  "stages": [
    {
      "id": "play-in",
      "name": "Play-In",
      "format": {
        "type": "swiss",
        "wins": 2,
        "losses": 2,
        "bestOf": { "default": 3, "decisive": 3 }
      },
      "entrants": [{ "entry": true }]
    },
    {
      "id": "swiss",
      "name": "Swiss Stage",
      "format": {
        "type": "swiss",
        "wins": 3,
        "losses": 3,
        "bestOf": { "default": 1, "decisive": 3 }
      },
      "entrants": [{ "entry": true }, { "stage": "play-in", "bucket": "qualified" }]
    },
    {
      "id": "knockout",
      "name": "Knockout Stage",
      "format": { "type": "singleElimination", "bestOf": [5, 5, 5], "seeding": "swissKnockout" },
      "entrants": [{ "stage": "swiss", "bucket": "qualified" }]
    }
  ],
  "placements": [
    { "stage": "knockout", "bucket": "champion", "place": [1, 1] },
    { "stage": "knockout", "bucket": "eliminated:final", "place": [2, 2] },
    { "stage": "knockout", "bucket": "eliminated:semifinal", "place": [3, 4] },
    { "stage": "knockout", "bucket": "eliminated:quarterfinal", "place": [5, 8] },
    { "stage": "swiss", "bucket": "eliminated:2-3", "place": [9, 11] },
    { "stage": "swiss", "bucket": "eliminated:1-3", "place": [12, 14] },
    { "stage": "swiss", "bucket": "eliminated:0-3", "place": [15, 16] },
    { "stage": "play-in", "bucket": "eliminated:1-2", "place": [17, 18] },
    { "stage": "play-in", "bucket": "eliminated:0-2", "place": [19, 20] }
  ]
}
