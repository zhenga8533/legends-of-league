---
import BaseLayout from "../../layouts/BaseLayout.astro";
import { editionsNewestFirst } from "../../lib/archive";
import { withBase } from "../../lib/paths";
import { editionSlug } from "../../lib/studio-data";
import Studio from "../../studio/Studio";

const editions = editionsNewestFirst.map((bundle) => ({
  slug: editionSlug(bundle),
  name: bundle.edition.name,
}));
---

<BaseLayout
  title="Simulation Studio"
  description="Replay or rewrite any international League of Legends tournament: pick winners, change ratings and run thousands of simulations."
>
  <h1 class="mb-2 text-3xl font-bold tracking-tight">Simulation Studio</h1>
  <p class="mb-6 max-w-3xl text-muted">
    Rerun any edition with its real format: from the start, or from any stage with the earlier
    stages' real results kept. Pick winners, adjust Elo ratings and run thousands of simulations to
    see how likely each outcome was.
  </p>
  <Studio client:only="react" editions={editions} dataBase={withBase("/simulate/data/")} />
  <noscript>
    <p class="text-muted">The Simulation Studio runs in your browser and needs JavaScript.</p>
  </noscript>
</BaseLayout>
