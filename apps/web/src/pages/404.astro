---
import BaseLayout from "../layouts/BaseLayout.astro";
import { withBase } from "../lib/paths";
---

<BaseLayout title="Page not found">
  <h1 class="mb-4 text-3xl font-bold tracking-tight sm:text-4xl">Page not found</h1>
  <p class="text-muted">
    This page doesn't exist. Try{" "}
    <a class="link" href={withBase("/tournaments/")}>
      browsing tournaments
    </a>
    or{" "}
    <a class="link" href={withBase("/search/")}>
      searching
    </a>
    .
  </p>
</BaseLayout>
