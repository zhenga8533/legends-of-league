---
import { editionSummary } from "@lol/data";
import LiveBadge from "../../components/LiveBadge.astro";
import TeamLink from "../../components/TeamLink.astro";
import BaseLayout from "../../layouts/BaseLayout.astro";
import { archive, editionsNewestFirst, paths } from "../../lib/archive";

// Oldest tournament first (Worlds, MSI, First Stand), as on the stats page.
const tournaments = [...archive.entities.tournaments.values()]
  .map((tournament) => ({
    tournament,
    editions: editionsNewestFirst.filter((b) => b.edition.tournament === tournament.id),
  }))
  .sort(
    (a, b) =>
      (a.editions.at(-1)?.edition.year ?? Infinity) - (b.editions.at(-1)?.edition.year ?? Infinity),
  );
---

<BaseLayout title="Tournaments" searchable>
  <h1 class="mb-6 text-3xl font-bold tracking-tight sm:text-4xl">Tournaments</h1>
  <div class="grid gap-6 md:grid-cols-3">
    {tournaments.map(({ tournament, editions }) => (
      <section class="card p-4" aria-labelledby={tournament.id}>
        <h2 id={tournament.id} class="text-xl font-semibold">
          <a class="hover:text-accent" href={paths.tournament(tournament.id)}>
            {tournament.name}
          </a>
        </h2>
        {editions.length === 0 ? (
          <p class="mt-2 text-sm text-muted">No editions imported yet.</p>
        ) : (
          <ul class="mt-3 space-y-1">
            {editions.map((bundle) => {
              const { champion } = editionSummary(bundle);
              return (
                <li class="flex justify-between gap-3">
                  <a class="link" href={paths.edition(bundle)}>
                    {bundle.edition.year}
                  </a>
                  {champion ? (
                    <TeamLink team={champion} />
                  ) : (
                    bundle.edition.status === "live" && <LiveBadge />
                  )}
                </li>
              );
            })}
          </ul>
        )}
      </section>
    ))}
  </div>
</BaseLayout>
