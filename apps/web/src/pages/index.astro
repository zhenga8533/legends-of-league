---
import { editionSummary, idSlug } from "@lol/data";
import LiveBadge from "../components/LiveBadge.astro";
import TeamLink from "../components/TeamLink.astro";
import BaseLayout from "../layouts/BaseLayout.astro";
import { archive, dateRange, editionsNewestFirst, paths } from "../lib/archive";
import { withBase } from "../lib/paths";

const live = archive.editions.filter((bundle) => bundle.edition.status === "live");
const totals = {
  editions: archive.editions.length,
  series: archive.editions.reduce((sum, b) => sum + b.series.length, 0),
  games: archive.editions.reduce((sum, b) => sum + b.games.length, 0),
  teams: archive.entities.teams.size,
};
---

<BaseLayout title="Legends of League" searchable>
  <section class="max-w-3xl space-y-4 py-6">
    <h1 class="text-4xl font-bold tracking-tight sm:text-5xl">Legends of League</h1>
    <p class="text-lg text-muted">
      An archive of international League of Legends tournaments, from brackets and standings down to
      drafts and player stats, with stats across every edition and a simulator for replaying history
      or forecasting events in progress.
    </p>
    <p class="flex flex-wrap gap-3 pt-2">
      <a
        href={withBase("/tournaments/")}
        class="rounded bg-accent px-4 py-2 font-semibold text-bg hover:bg-accent-strong"
      >
        Browse tournaments
      </a>
      <a
        href={withBase("/search/")}
        class="rounded border border-border px-4 py-2 hover:border-accent"
      >
        Search teams and players
      </a>
    </p>
  </section>

  {live.length > 0 && (
    <section aria-labelledby="live" class="space-y-3 py-4">
      <h2 id="live" class="text-2xl font-semibold tracking-tight">
        Happening now
      </h2>
      <ul class="grid gap-4 md:grid-cols-2">
        {live.map((bundle) => (
          <li class="space-y-2 rounded border border-loss bg-surface p-4">
            <h3 class="font-semibold">
              <a class="hover:text-accent" href={paths.edition(bundle)}>
                {bundle.edition.name}
              </a>{" "}
              <LiveBadge />
            </h3>
            <p class="text-sm text-muted">
              {dateRange(bundle.edition.dates.start, bundle.edition.dates.end)} ·{" "}
              {bundle.series.filter((s) => s.score).length} of {bundle.series.length} scheduled
              series played
            </p>
            <p class="flex flex-wrap gap-3 text-sm">
              <a class="link" href={paths.edition(bundle)}>
                Results and upcoming matches
              </a>
              <a class="link" href={withBase(`/simulate/#ed=${idSlug(bundle.edition.id)}`)}>
                Forecast the rest
              </a>
            </p>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section aria-labelledby="totals" class="py-4">
    <h2 id="totals" class="sr-only">
      Archive size
    </h2>
    <dl class="grid grid-cols-2 gap-3 sm:grid-cols-4">
      {[
        ["Editions", totals.editions],
        ["Series", totals.series],
        ["Games", totals.games],
        ["Teams", totals.teams],
      ].map(([label, value]) => (
        <div class="rounded border border-border bg-surface p-4">
          <dt class="text-sm text-muted">{label}</dt>
          <dd class="text-2xl font-semibold tabular-nums">{value}</dd>
        </div>
      ))}
    </dl>
  </section>

  <section aria-labelledby="recent" class="space-y-4 py-6">
    <h2 id="recent" class="text-2xl font-semibold tracking-tight">
      Recent editions
    </h2>
    <ul class="grid gap-4 md:grid-cols-3">
      {editionsNewestFirst.map((bundle) => {
        const summary = editionSummary(bundle);
        return (
          <li class="rounded border border-border bg-surface p-4">
            <h3 class="font-semibold">
              <a class="hover:text-accent" href={paths.edition(bundle)}>
                {bundle.edition.name}
              </a>
            </h3>
            <p class="text-sm text-muted">
              {dateRange(bundle.edition.dates.start, bundle.edition.dates.end)}
            </p>
            {summary.champion && (
              <p class="mt-3">
                <span class="text-sm text-muted">Champion </span>
                <span class="font-semibold">
                  <TeamLink team={summary.champion} />
                </span>
              </p>
            )}
            {summary.final?.score && summary.runnerUp && (
              <p class="text-sm text-muted">
                Beat <TeamLink team={summary.runnerUp} /> {Math.max(...summary.final.score)}–
                {Math.min(...summary.final.score)} in the final
              </p>
            )}
          </li>
        );
      })}
    </ul>
  </section>
</BaseLayout>
