# Copy to .env (git-ignored) for local imports, then run from ingest/:
#   uv run --env-file ../.env lol-ingest run --tournament worlds --year 2024 --op dry-run
# Create a bot password at https://lol.fandom.com/wiki/Special:BotPasswords with the Cargo
# grant; anonymous Cargo queries are rate-limited to the point of being unusable.
LEAGUEPEDIA_BOT_USER=YourFandomName@your-bot-name
LEAGUEPEDIA_BOT_PASSWORD=
